# Copy to .env.prod on the server and fill it in (deploy/generate-env.sh does that).
# The real file is never committed.
SITE_ADDRESS=your-host.example.com
IMAGE_TAG=latest
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=
# Optional: only for testing on a machine where 80/443 are taken
# HTTP_PORT=8080
# HTTPS_PORT=8443